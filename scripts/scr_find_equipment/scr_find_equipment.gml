
function scr_find_equipment(argument0){

var name = argument0

switch (name)
{
case "Kris":

weapon =  global.weapon[0]
armor_I = global.armor_1[0]
armor_II = global.armor_2[0]
break

case "Susie":

weapon =  global.weapon[1]
armor_I = global.armor_1[1]
armor_II = global.armor_2[1]
break

case "Ralsei":

weapon =  global.weapon[2]
armor_I = global.armor_1[2]
armor_II = global.armor_2[2]
break

case "Toriel":

weapon =  global.weapon[3]
armor_I = global.armor_1[3]
armor_II = global.armor_2[3]
break

}
}