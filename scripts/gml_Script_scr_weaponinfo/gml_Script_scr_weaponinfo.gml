            weaponchar3temp = false
            weaponchar4temp = false
			weaponchara5temp = false
             global.weaponabilitytemp = " "
            global.weaponabilityicontemp = spr_symbol_mini_empty
            global.weaponicontemp = spr_symbol_mini_sword
            global.value = 0
            break
			case "Kris's hand":
            weaponnametemp = stringsetloc("Kris's hand") //the name of the weapon
            global.weapondesctemp = stringsetloc("It's kris's hand?") //The description
            amessage2temp = stringsetloc("Why do you have 3 hands?") //Susie reaction to equipping
            amessage3temp = stringsetloc("KRIS?!") //Ralsei reaction
            amessage4temp = stringsetloc("Hey, stop it! Fahaha") //Noelle's reaction (she isn't in the game, i'll  save this for the tutorial of creating party members.
			amessage5temp = stringsetloc("WHAT?! Kris, honey, are you hurt?!") //Toriel reaction
            global.weaponattemp = 1 //The extra attack it gives
            global.weapondftemp = -1 //The extra defense 
            global.weaponmagtemp = 0 //The extra magic
            weaponboltstemp = 0  //This two i have no IDEA what i want to do, because they aren't used nor in deltarune nor here yet, maybe for the duration of the turn with the wristwatch
            weaponstyletemp = " "
            weapongrazeamttemp = 0 //This is the time you can graze a bullet before it gives less TP
            weapongrazesizetemp = 0 //This is the size of the graze area, it makes it bigger or smaller depending on what you put it (it multiplies the graze area with this)
            weaponchar1temp = true //If kris can equip
            weaponchar2temp = false //if susie can equip
            weaponchar3temp = false //If ralsei can equip
            weaponchar4temp = false //if noelle can equip
			weaponchara5temp = false //If toriel can equip
            global.weaponabilitytemp = "Creepyness"//The name of the ability, if it gives you one
            global.weaponabilityicontemp = spr_symbol_mini_evil //The symbol of the weapon ability, so the little simbol near the ability
            global.weaponicontemp = spr_symbol_mini_sword //The icon next to the weapon name, Sword for kris, Axe for susie, scarf for ralsei, ring for noelle...
            global.value = 0 //The global.value for selling it to shops
            break
    }

}

