//scr_info_member
function scr_info_member(argument0){

if argument0 = "Kris"
{
draw_lv = global.member_LV[0]
draw_title = global.member_title[0]
global.member_info = "The leader that ACTs througt ACTing"
}
if argument0 = "Susie"
{
draw_lv = global.member_LV[1]
draw_title = global.member_title[1]
global.member_info = "The RUDE warrior that stopped ATTACKing"
	
}
if argument0 = "Ralsei"
{
draw_lv = global.member_LV[2]
draw_title = global.member_title[2]
global.member_info = "The prince of MERCY and DARKness"
	
}
if argument0 = "Toriel"
{
draw_lv = global.member_LV[3]
draw_title = global.member_title[3]
global.member_info = "The mage of fire and protector of the light"
	
}


}