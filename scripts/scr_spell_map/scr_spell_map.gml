
function scr_spell_map(){

// Create the spells_map in your initialization script
global.spells_map = ds_map_create();

// Populate the spells_map with the spells for each party member
global.spells_map[? "Kris"] = global.spells_Kris;
global.spells_map[? "Susie"] = global.spells_Susie;
global.spells_map[? "Ralsei"] = global.spells_Ralsei;
global.spells_map[? "Toriel"] = global.spells_Toriel;



}